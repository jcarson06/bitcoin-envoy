# Serve each route's prerendered HTML directly (200 = rewrite, URL stays the same).
# These take precedence over the SPA catch-all below.
/                   /index.html                 200
/learn              /learn/index.html            200
/faq                /faq/index.html              200
/about              /about/index.html            200
/privacy-policy     /privacy-policy/index.html   200
/terms-of-service   /terms-of-service/index.html 200

# Retired routes: permanently redirect so existing links and search results
# land somewhere useful instead of a soft 404.
/coaching           /learn                       301!

