# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Incremental build state written by `tsc -b` (npm run typecheck)
*.tsbuildinfo

# Environment files — never commit these. Vite inlines anything prefixed
# VITE_ into the client bundle, so treat every value here as public anyway.
.env
.env.*
!.env.example

# Local agent settings. Machine-specific and potentially permission-granting,
# so it must never be committed. This is currently also covered by a global
# ignore on one machine — repeated here so the rule travels with the repo.
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Intermediate card renders — regenerate with build/README.md.
# The HTML sources and the original art are tracked; these are not.
build/og-photo.png
build/og-typographic.png
